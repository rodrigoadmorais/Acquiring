          "name": "Google account cIlo-Xx5bNUIVd3qo"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// A primeira célula da aba (A1) é usada pelo n8n como nome da coluna.\n// Ela contém o nome da versão do forecast, ex: 'forecast ABR'.\n// Extraímos, convertemos para notação N+M e taggeamos cada linha.\n\nconst items = $input.all();\nif (items.length === 0) return [];\n\nconst monthMap = {\n  'jan': '0+12', 'fev': '1+11', 'mar': '2+10', 'abr': '3+9',\n  'mai': '4+8', 'jun': '5+7', 'jul': '6+6', 'ago': '7+5',\n  'set': '8+4', 'out': '9+3', 'nov': '10+2', 'dez': '11+1'\n};\n\nconst allKeys = Object.keys(items[0].json);\nconst versionKey = allKeys.find(k => String(k).toLowerCase().trim().startsWith('forecast '));\n\nlet versionLabel = null;\nif (versionKey) {\n  const rest = versionKey.substring(9).trim();\n  const parts = rest.split(/\\s+/);\n  const monthKey = parts[0].toLowerCase();\n  const suffix = parts.slice(1).join(' ');\n  const nm = monthMap[monthKey];\n  if (nm) versionLabel = suffix ? `Forecast ${nm} ${suffix}` : `Forecast ${nm}`;\n}\n\nreturn items.map(item => ({\n  json: versionLabel ? { ...item.json, _version: versionLabel } : item.json\n}));"
      },
