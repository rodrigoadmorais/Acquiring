      "id": "f87c6dd4-3d17-4040-9a96-57f4b1f123e9",
      "name": "Get Forecast",
      "type": "n8n-nodes-base.googleSheets",
      "position": [-80, 0],
      "executeOnce": true,
      "typeVersion": 4.7,
      "credentials": {
        "googleGenericOAuth2Api": {
